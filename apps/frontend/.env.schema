# Environment schema for the TTS frontend (https://varlock.dev).
# On/off flags are declared as `boolean` (accepts `true`/`false`, `1`/`0`, `yes`/`no`, `on`/`off`).
# Read them in code through varlock's typed `ENV` object (`import { ENV } from 'varlock/env'`), which
# the Vite plugin inlines as real booleans. `import.meta.env.*` is always a string (`"false"` is truthy!).
# Local overrides go in a git-ignored `.env` (or `.env.local`); this file only holds
# defaults and non-secret values and is committed.
#
# Only `VITE_`-prefixed items are public (bundled into the client); everything else is
# sensitive and never exposed to the browser.
#
# @defaultRequired=infer
# @defaultSensitive=inferFromPrefix(VITE_)
# @generateTsTypes(path=src/env.d.ts)
# ---

# Whether this is a production build (true) or a development one (false)
# @type=boolean
VITE_APP_PROD=false

# Enables staging-only features on a production build
# @type=boolean
VITE_APP_STAGING=false

# @type=string(matches=regex("^\d{4}-\d{2}-\d{2}$"))
VITE_APP_RELEASE_DATE=2023-01-27

# Dev server port
# @public
# @type=port
PORT=3100

# Plausible analytics (optional)
VITE_APP_PLAUSIBLE_DOMAIN=
VITE_APP_PLAUSIBLE_HOST=

# Semester to use (defaults to the current one when empty)
VITE_APP_SEMESTER=

# Overrides the default site title when set
VITE_APP_SITE_TITLE=

# Backend URL for the new Elysia backend. Leave empty in dev (falls back to the
# local server at http://localhost:3000, which serves the API without a path
# prefix); set it per deployment for staging and production through the
# `TTS_FE_VARS_CONTENT` secret. Niployments mounts the backend under `/api`, so
# the deployed value must include it (e.g. https://tts.niaefeup.pt/api). When
# empty in a production build, it falls back to the page origin plus `/api`.
# @type=url
VITE_APP_BACKEND_URL=

# Whether theoretical classes should generate conflicts
# @type=boolean
VITE_APP_T_CLASS_CONFLICTS=false

# Sentry DSN; leave empty to disable error tracking
# @type=url
VITE_APP_SENTRY_DSN=https://01f0882e6aa029a125426e4ad32e6c18@o553498.ingest.us.sentry.io/4507775325437952

# Enables Sentry tracing and session replay
# @type=boolean
VITE_APP_SENTRY_TRACING=false

# Enables federated (OIDC) authentication. Off by default for local dev (login
# with username/password via the backend's dev-login); production sets it true.
# @type=boolean
VITE_APP_FEDERATED_AUTH=false

# Only needed to upload source maps to Sentry
# @optional @sensitive
# @docs(https://docs.sentry.io/organization/integrations/integration-platform/internal-integration/#auth-tokens)
SENTRY_AUTH_TOKEN=
