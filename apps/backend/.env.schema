# Environment schema for the TTS backend (https://varlock.dev).
# Local values go in a git-ignored `.env` (or `.env.local`); this file is committed and
# must never contain real credentials.
#
# @defaultRequired=infer
# @defaultSensitive=true
# ---

# Port the Elysia server listens on
# @public
# @type=port
PORT=3000

# PostgreSQL connection string (requires PostgreSQL >= 15)
# @required @sensitive
# @type=url(prependHttps=false)
# @example="postgres://user:password@localhost:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://tts:tts@localhost:5434"

# NMEC ("up" number) that `bun run db:seed:demo` installs as the admin user.
# Leave the default for a generic "admin"; override it in `.env` (git-ignored)
# with your own NMEC to seed yourself as admin. Either `up202207150` or
# `202207150` works — the `up` prefix is normalised away.
# @public
# @type=string
ADMIN_UP="2026xxxxx"

# Role the ADMIN_UP account is seeded with by `bun run db:seed:demo`.
# @public
# @type=enum(USER,ADMIN,SUPERUSER)
ADMIN_ROLE="ADMIN"

# --- Auth (Sigarra OIDC) ---
# Client credentials for the Sigarra Keycloak realm. Both must be set for the
# OIDC login routes to work; without them the routes answer `OIDC_NOT_CONFIGURED`
# so a local checkout still boots.
# @optional @sensitive
OIDC_CLIENT_ID=
# @optional @sensitive
OIDC_CLIENT_SECRET=

# Where Sigarra redirects back after login. Must be registered on the Keycloak
# client. In production this is the public URL, e.g.
# https://tts.niaefeup.pt/api/v1/auth/callback (the `/api` is added by the
# deployment; locally there is no proxy so it is absent).
# @optional
OIDC_REDIRECT_URI="http://localhost:3000/v1/auth/callback"

# Sigarra (Keycloak) endpoints and scopes. Defaults target the FEUP realm.
# @optional
OIDC_AUTHORIZE_ENDPOINT="https://open-id.up.pt/realms/sigarra/protocol/openid-connect/auth"
# @optional
OIDC_TOKEN_ENDPOINT="https://open-id.up.pt/realms/sigarra/protocol/openid-connect/token"
# @optional
OIDC_USERINFO_ENDPOINT="https://open-id.up.pt/realms/sigarra/protocol/openid-connect/userinfo"
# @optional
OIDC_SCOPES="openid email profile uporto_data"

# Lifetime of an issued session, in days.
# @optional @sensitive=false
SESSION_TTL_DAYS=30

# Frontend origin used as the default post-login destination and for the
# login `return_to` allowlist. Set per environment: dev http://localhost:3100,
# staging/production the deployed frontend origin (e.g. https://tts.niaefeup.pt).
# @optional
FRONTEND_URL="http://localhost:3100"

# Comma-separated origins allowed by CORS (credentialed requests). Must include
# the deployed frontend origin in staging and production, otherwise the browser
# blocks every API call and the session cookie is never sent.
# @optional
ALLOWED_ORIGINS="http://localhost:3100"

# Force the Secure attribute on auth cookies (defaults to NODE_ENV=production).
# @optional @type=boolean @sensitive=false
COOKIE_SECURE=false

# Enables the dev-only username/password login (`POST /v1/auth/dev-login`
# and the `/sigarra_login/` shim). On by default for local dev; always off when
# NODE_ENV=production, and prod should set it false explicitly too.
# @optional @type=boolean @sensitive=false
DEV_LOGIN_ENABLED=true

# Path prefix the deployment mounts this service under. Niployments exposes it
# at `/api`, so production defaults this to `/api`; leave empty in local dev,
# where the backend is reached directly on :3000. Only used for browser-visible
# (absolute) URLs — route declarations never include it.
# @optional @sensitive=false
PUBLIC_API_PREFIX=""

# Sigarra account the dev login uses when the request carries no credentials.
# Only read in dev; leave empty in production.
# @optional @sensitive=false
SIGARRA_USERNAME=""
# @optional @sensitive
SIGARRA_PASSWORD=""
